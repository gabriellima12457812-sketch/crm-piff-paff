{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/setup-admin",
      "destination": "/setup-admin.html"
    },
    {
      "source": "/api/admin/users/:id/toggle-status",
      "destination": "/api/edson?gov_route=admin_users&action=toggle_status&id=:id"
    },
    {
      "source": "/api/admin/users",
      "destination": "/api/edson?gov_route=admin_users"
    },
    {
      "source": "/api/auth",
      "destination": "/api/edson?gov_route=auth"
    },
    {
      "source": "/api/setup-admin",
      "destination": "/api/edson?gov_route=setup_admin"
    },
    {
      "source": "/api/n8n-webhook",
      "destination": "/api/edson?gov_route=n8n_webhook"
    },
    {
      "source": "/api/vendedor/:seller",
      "destination": "/api/edson?seller=:seller"
    },
    {
      "source": "/pasta_digital",
      "destination": "/pasta_digital.html"
    },
    {
      "source": "/pedidos",
      "destination": "/contracts"
    },
    {
      "source": "/gerador-pedidos",
      "destination": "/contracts"
    },
    {
      "source": "/atendimento",
      "destination": "/atendimento.html"
    },
    {
      "source": "/qualificacao",
      "destination": "/atendimento.html"
    },
    {
      "source": "/conectar",
      "destination": "/conectar_whatsapp.html"
    },
    {
      "source": "/conectar-whatsapp",
      "destination": "/conectar_whatsapp.html"
    },
    {
      "source": "/conectar_whatsapp",
      "destination": "/conectar_whatsapp.html"
    },
    {
      "source": "/api/felipe/find-instagram",
      "destination": "/api/felipe.js?action=findInstagramLead"
    },
    {
      "source": "/api/felipe/move-to-whatsapp",
      "destination": "/api/felipe.js?action=moveInstagramLeadToWhatsApp"
    },
    {
      "source": "/api/gabriel/find-instagram",
      "destination": "/api/gabriel.js?action=findInstagramLead"
    },
    {
      "source": "/api/gabriel/move-to-whatsapp",
      "destination": "/api/gabriel.js?action=moveInstagramLeadToWhatsApp"
    },
    {
      "source": "/api/mayara/find-instagram",
      "destination": "/api/mayara.js?action=findInstagramLead"
    },
    {
      "source": "/api/mayara/move-to-whatsapp",
      "destination": "/api/mayara.js?action=moveInstagramLeadToWhatsApp"
    },
    {
      "source": "/api/barbara/find-instagram",
      "destination": "/api/barbara.js?action=findInstagramLead"
    },
    {
      "source": "/api/barbara/move-to-whatsapp",
      "destination": "/api/barbara.js?action=moveInstagramLeadToWhatsApp"
    },
    {
      "source": "/api/eduardo/find-instagram",
      "destination": "/api/eduardo.js?action=findInstagramLead"
    },
    {
      "source": "/api/eduardo/move-to-whatsapp",
      "destination": "/api/eduardo.js?action=moveInstagramLeadToWhatsApp"
    },
    {
      "source": "/api/rodrigo/find-instagram",
      "destination": "/api/rodrigo.js?action=findInstagramLead"
    },
    {
      "source": "/api/rodrigo/move-to-whatsapp",
      "destination": "/api/rodrigo.js?action=moveInstagramLeadToWhatsApp"
    },
    {
      "source": "/freelancer",
      "destination": "/freelancer.html"
    },
    {
      "source": "/freelancer-bc",
      "destination": "/freelancer.html"
    },
    {
      "source": "/((?!api/|freelancer|contracts|draft|openapi|privacy|pasta_digital|atendimento|pedidos|gerador-pedidos|conectar|setup-admin).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}