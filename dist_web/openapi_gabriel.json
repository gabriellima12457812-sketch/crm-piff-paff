{
  "openapi": "3.1.0",
  "info": {
    "title": "PIFF PAFF CRM - Gabriel Lima",
    "description": "API Oficial do CRM Piff Paff para Gabriel Lima (Zero Autenticação, direta ao Vercel e Supabase).",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://crm-piff-paff-v2.vercel.app"
    }
  ],
  "paths": {
    "/api/gabriel": {
      "get": {
        "operationId": "consultarLeadsGabriel",
        "summary": "Consulta total de leads e resumo do funil de Gabriel",
        "description": "Retorna o total de clientes cadastrados, valor do pipeline e resumo do funil de Gabriel.",
        "parameters": [
          {
            "name": "stage",
            "in": "query",
            "required": false,
            "description": "Filtrar por estagio: novos, investigacao, projetos, proposta, fechamento, concluidas",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Buscar cliente por nome, telefone ou cidade",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dados retornados com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsultarResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "gerenciarLeadGabriel",
        "summary": "Cadastra, atualiza, exclui ou reorganiza leads de Gabriel",
        "description": "Permite cadastrar novos clientes, atualizar notas, excluir leads e mover estagios.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeadInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operacao executada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcaoResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConsultarResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Indica se a requisicao foi atendida"
          },
          "seller": {
            "type": "string",
            "description": "Nome do vendedor"
          },
          "total_leads": {
            "type": "integer",
            "description": "Total de clientes encontrados"
          },
          "total_clients": {
            "type": "integer",
            "description": "Total de clientes no banco"
          },
          "pipeline_total_value_formatted": {
            "type": "string",
            "description": "Valor total formatado em Reais"
          },
          "message": {
            "type": "string",
            "description": "Resumo explicativo do funil"
          }
        }
      },
      "AcaoResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Indica se a acao foi bem sucedida"
          },
          "action": {
            "type": "string",
            "description": "Tipo de acao executada (create, update, delete, reorganize)"
          },
          "message": {
            "type": "string",
            "description": "Mensagem descritiva do resultado da operacao"
          }
        }
      },
      "LeadInput": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "upsert",
              "delete",
              "reorganize",
              "list",
              "count"
            ],
            "description": "Acao a ser executada: 'upsert', 'delete' ou 'reorganize'"
          },
          "id": {
            "type": "string",
            "description": "ID do lead se ja existir no CRM"
          },
          "name": {
            "type": "string",
            "description": "Nome completo do cliente"
          },
          "phone": {
            "type": "string",
            "description": "Telefone ou WhatsApp"
          },
          "instagram": {
            "type": "string",
            "description": "Instagram (@perfil)"
          },
          "stage": {
            "type": "string",
            "description": "Estagio do funil: novos, investigacao, projetos, proposta, fechamento, concluidas"
          },
          "value": {
            "type": "number",
            "description": "Valor da negociacao em Reais (ex: 25000)"
          },
          "temperature": {
            "type": "string",
            "enum": [
              "quente",
              "morno",
              "frio"
            ],
            "description": "Temperatura comercial"
          },
          "priority": {
            "type": "string",
            "enum": [
              "MAXIMA",
              "ALTA",
              "MEDIA",
              "BAIXA"
            ],
            "description": "Prioridade de atendimento"
          },
          "category": {
            "type": "string",
            "description": "Linha ou categoria do produto"
          },
          "notes": {
            "type": "string",
            "description": "Anotacoes, historico da conversa e detalhes"
          }
        }
      }
    }
  }
}