{
  "openapi": "3.1.0",
  "info": {
    "title": "PIFF PAFF CRM - Felipe",
    "description": "API Oficial do CRM Piff Paff para Felipe (Zero Autenticação, direta ao Vercel e Supabase).",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://crm-piff-paff-v2.vercel.app"
    }
  ],
  "paths": {
    "/api/felipe": {
      "get": {
        "operationId": "consultarLeadsFelipe",
        "summary": "Consulta total de leads e resumo do funil de Felipe",
        "description": "Retorna o total de clientes cadastrados, valor do pipeline e resumo do funil de Felipe.",
        "parameters": [
          {
            "name": "stage",
            "in": "query",
            "required": false,
            "description": "Filtrar por estagio: novos, investigacao, projetos, proposta, fechamento, concluidas",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Buscar cliente por nome, telefone ou cidade",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dados retornados com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "seller": {
                      "type": "string"
                    },
                    "total_leads": {
                      "type": "integer"
                    },
                    "total_clients": {
                      "type": "integer"
                    },
                    "pipeline_total_value_formatted": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "gerenciarLeadFelipe",
        "summary": "Cadastra, atualiza, exclui ou reorganiza leads de Felipe",
        "description": "Permite cadastrar novos clientes, atualizar notas, excluir leads e mover estagios.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "upsert",
                      "delete",
                      "reorganize",
                      "list",
                      "count"
                    ],
                    "description": "Acao a ser executada: 'upsert', 'delete', 'reorganize' ou 'count'"
                  },
                  "id": {
                    "type": "string",
                    "description": "ID do lead se ja existir no CRM"
                  },
                  "name": {
                    "type": "string",
                    "description": "Nome completo do cliente"
                  },
                  "phone": {
                    "type": "string",
                    "description": "Telefone ou WhatsApp"
                  },
                  "instagram": {
                    "type": "string",
                    "description": "Instagram (@perfil)"
                  },
                  "stage": {
                    "type": "string",
                    "description": "Estagio do funil: novos, investigacao, projetos, proposta, fechamento, concluidas"
                  },
                  "value": {
                    "type": "number",
                    "description": "Valor da negociacao em Reais (ex: 25000)"
                  },
                  "temperature": {
                    "type": "string",
                    "enum": [
                      "quente",
                      "morno",
                      "frio"
                    ],
                    "description": "Temperatura comercial"
                  },
                  "priority": {
                    "type": "string",
                    "enum": [
                      "MAXIMA",
                      "ALTA",
                      "MEDIA",
                      "BAIXA"
                    ],
                    "description": "Prioridade de atendimento"
                  },
                  "category": {
                    "type": "string",
                    "description": "Linha ou categoria do produto"
                  },
                  "notes": {
                    "type": "string",
                    "description": "Anotacoes, historico da conversa e detalhes"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operacao executada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "action": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}